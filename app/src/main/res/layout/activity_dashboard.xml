<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_vamara">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Bienvenido a Vamara"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Saldo disponible"
            android:textColor="#9DA5B4"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="$0 COP"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Ingresos"
            android:textColor="#C8FF3D"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvIngresos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="$0"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Gastos"
            android:textColor="#FF8585"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="$0"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Movimientos recientes"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>


        <TextView
            android:id="@+id/tvListaMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cargando movimientos..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="10dp"/>


        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="48dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:backgroundTint="#C8FF3D"
            android:textColor="#0D0F14"/>

        <Button
            android:id="@+id/btnNuevoMovimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="+ Nuevo movimiento"
            android:textAllCaps="false"
            android:textColor="#0D0F14"
            android:backgroundTint="#C8FF3D"/>

    </LinearLayout>
</ScrollView>
