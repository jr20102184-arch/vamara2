<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_vamara">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/tvVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="← Volver"
            android:textColor="#C8FF3D"
            android:textSize="16sp"/>

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:layout_marginTop="35dp"
            android:src="@drawable/logou_vamara"
            android:contentDescription="Logo de Vamara"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Bienvenido de nuevo."
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tus finanzas están en buenas manos."
            android:textColor="#9DA5B4"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="45dp"
            android:backgroundTint="#C8FF3D"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#9DA5B4"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#C8FF3D"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#9DA5B4"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="35dp"
            android:text="Iniciar sesión"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0D0F14"
            android:enabled="true"
            android:backgroundTint="#C8FF3D"/>


        <TextView
            android:id="@+id/tvIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="#C8FF3D"
            android:textSize="15sp"/>


    </LinearLayout>
</ScrollView>
